# Draw.io Export MCP Server Configuration
# Copy this file to .env and adjust as needed

# Export server URL (default: local LAN server)
DRAWIO_EXPORT_URL=http://192.168.1.210:18765/ImageExport4/export

# Workspace root - files outside this directory cannot be read/written
# Default: auto-detected from current working directory at startup
# DRAWIO_WORKSPACE_ROOT=/path/to/your/project

# HTTP request timeout in seconds
DRAWIO_REQUEST_TIMEOUT=60

# Maximum input file size in megabytes
DRAWIO_MAX_INPUT_SIZE_MB=20

# Maximum output file size in megabytes
DRAWIO_MAX_OUTPUT_SIZE_MB=100
